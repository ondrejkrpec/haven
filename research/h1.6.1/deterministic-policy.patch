diff --git a/agent/deterministic_policy.py b/agent/deterministic_policy.py
new file mode 100644
index 00000000..e2c9cb8a
--- /dev/null
+++ b/agent/deterministic_policy.py
@@ -0,0 +1,30 @@
+"""Irreversible process policy for hosts serving deterministic operations only.
+
+A trusted launcher arms this before loading plugins or constructing agents. The
+consumer hook remains fail-open; model and tool execution cannot cross this gate.
+This is not isolation against arbitrary Python code running in this process.
+"""
+from __future__ import annotations
+
+from typing import Callable
+
+_armed = False
+_observer: Callable[[str], None] | None = None
+
+
+def arm_deterministic_policy(observer: Callable[[str], None]) -> None:
+    """Latch the host policy for this process; no unarm or replacement API."""
+    global _armed, _observer
+    if _armed or not callable(observer):
+        raise RuntimeError("deterministic policy cannot be replaced")
+    _observer = observer
+    _armed = True
+
+
+def require_nondeterministic_access(action: str) -> None:
+    if not _armed:
+        return
+    try:
+        _observer(action)
+    finally:
+        raise PermissionError("Deterministic host: model and tool execution are disabled")
