[Unit]
Description=Read-only native Haven health check for backup and monitoring
After=haven.service

[Service]
Type=oneshot
User=haven
Group=haven
WorkingDirectory=/var/lib/haven/releases/hermes-bf0203a-785f2646
Environment=HOME=/var/lib/haven
Environment=PATH=/usr/bin:/bin
Environment=HERMES_HOME=/var/lib/haven/.hermes
Environment=PYTHONPATH=/var/lib/haven/haven-tools
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/var/lib/haven/telegram/venv/bin/python -m scripts.service_runtime health --source /var/lib/haven/releases/hermes-bf0203a-785f2646 --home /var/lib/haven/.hermes
TimeoutStartSec=20
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
MemoryMax=128M
TasksMax=32
StandardOutput=null
StandardError=null
