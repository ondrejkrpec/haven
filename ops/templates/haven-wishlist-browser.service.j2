[Unit]
Description=Haven isolated Alza virtual browser
After=haven-wishlist-egress.service
Wants=haven-wishlist-egress.service
StartLimitIntervalSec=0

[Service]
Type=exec
User=haven-browser
Group=haven-wishlist-browser
SupplementaryGroups=haven-wishlist-egress
RuntimeDirectory=haven-wishlist-browser
RuntimeDirectoryMode=0750
WorkingDirectory=/opt/haven-wishlist-browser/app
Environment=PYTHONPATH=/opt/haven-wishlist-browser/app
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/haven-wishlist-browser/venv/bin/python -B -m scripts.wishlist_browser serve --config /etc/haven-wishlist-browser/browser.json
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=78
TimeoutStopSec=10
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectProc=invisible
InaccessiblePaths=-/var/lib/haven -/var/lib/haven-wishlist -/var/lib/haven-language -/var/lib/haven-backup -/etc/haven-backup -/etc/haven-wishlist -/run/haven-wishlist -/run/haven-wishlist-collection
MemoryMax=1536M
CPUQuota=100%
TasksMax=256
LimitNOFILE=1024
StandardOutput=journal
StandardError=null

[Install]
WantedBy=multi-user.target
